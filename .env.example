# Copy to .env and fill in. .env is git-ignored.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hep_th_rag
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Connection string for the app (keep in sync with the values above)
DATABASE_URL=postgresql://postgres:change-me@localhost:5433/hep_th_rag

# LLM for the API (api/): a local Ollama server
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# true = let thinking models reason before answering (better, slower to start)
OLLAMA_THINK=false
# Origins allowed to call the API (the web UI in web/), comma-separated
CORS_ORIGINS=http://localhost:3000
